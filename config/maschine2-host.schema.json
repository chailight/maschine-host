{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.maschine2-host/schema/v1",
  "title": "Maschine2 host configuration",
  "description": "Schema version 1. Controller numbers may be null placeholders. They are not firmware assignments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "midi_outputs", "groups", "encoder_pages"],
  "properties": {
    "schema_version": { "const": 1 },
    "log_level": { "enum": ["error", "info", "debug"] },
    "midi_outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "virtual_port": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_interval_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": { "type": ["string", "null"] },
        "sample_rate": { "type": "integer", "minimum": 1 },
        "buffer_frames": { "type": "integer", "minimum": 1 },
        "polyphony": { "type": "integer", "minimum": 1 }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/group" }
    },
    "encoder_pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "mode", "destination", "notes"],
      "properties": {
        "id": { "enum": ["A", "B", "C", "D", "E", "F", "G", "H"] },
        "label": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["one_shot", "chromatic", "scale"] },
        "destination": { "$ref": "#/$defs/destination" },
        "notes": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 0, "maximum": 127 }
        },
        "trigger": { "enum": ["note_off", "ignore_release"] },
        "samples": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "choke": { "type": "integer", "minimum": 0, "maximum": 127 }
                }
              }
            ]
          }
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "root", "lo", "hi"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "root": { "type": "integer", "minimum": 0, "maximum": 127 },
              "lo": { "type": "integer", "minimum": 0, "maximum": 127 },
              "hi": { "type": "integer", "minimum": 0, "maximum": 127 }
            }
          }
        }
      }
    },
    "destination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port", "channel"],
          "properties": {
            "type": { "const": "midi" },
            "port": { "type": "string", "minLength": 1 },
            "channel": { "type": "integer", "minimum": 1, "maximum": 16 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instrument"],
          "properties": {
            "type": { "const": "sampler" },
            "instrument": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "encoders"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "encoders": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/encoder" }
        }
      }
    },
    "encoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "type"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["midi_cc", "local", "macro", "unbound"] },
        "port": { "type": "string" },
        "channel": { "type": "integer", "minimum": 1, "maximum": 16 },
        "cc": { "type": ["integer", "null"], "minimum": 0, "maximum": 127 },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "default": { "type": "integer" },
        "target": { "type": "string" },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["port", "channel", "cc"],
            "properties": {
              "port": { "type": "string" },
              "channel": { "type": "integer", "minimum": 1, "maximum": 16 },
              "cc": { "type": "integer", "minimum": 0, "maximum": 127 }
            }
          }
        }
      }
    }
  }
}
